<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Severity__c</fullName>
    <description>Severidad de una medición aceptada, según los límites de Measurement_Threshold__mdt vigentes cuando se procesó. Vacío en rechazos y en señales de conectividad. Cambiar un límite después no la modifica.</description>
    <inlineHelpText>Normal, Advertencia o Crítico con los límites vigentes al procesar la señal.</inlineHelpText>
    <label>Severity</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Normal</fullName>
                <default>false</default>
                <label>Normal</label>
            </value>
            <value>
                <fullName>Warning</fullName>
                <default>false</default>
                <label>Advertencia</label>
            </value>
            <value>
                <fullName>Critical</fullName>
                <default>false</default>
                <label>Crítico</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
